---
// Landing.astro
// Weir — the landing page at each language's address: its head and markup. Words are in `src/site.ts`, the look in `src/styles/landing.css`, and the behavior in `src/scripts/landing.js`.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import landingScript from "../scripts/landing.js?raw";
import { docsOf, DOWNLOAD_URL, homeOf, LANG_STORAGE_KEY, LANGS, REPO_URL, STRINGS, type Lang } from "../site";
import "../styles/tokens.css";
import "../styles/nav.css";
import "../styles/landing.css";
import PageHead from "./PageHead.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = STRINGS[lang];
const url = new URL(homeOf(lang), Astro.site).href;

// Every capture in the two sizes a screen can want, made at build time. A phone's hero stays small, while the story zooms in far enough to need the large one.
const captureFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/captures/*.png", { eager: true });
async function capture(name: string, look: string) {
  const file = captureFiles[`../assets/captures/${name}-${look}.png`];
  if (!file) throw new Error(`No capture ${name}-${look}. Run make site-images.`);
  const [small, large] = await Promise.all(
    [1440, 2880].map((width) => getImage({ src: file.default, width, format: "webp", quality: 80 })),
  );
  return { small: small?.src, large: large?.src };
}
const captures: Record<string, Record<string, { small?: string; large?: string }>> = {};
for (const name of ["hero", "needs-attention", "all-projects", "review"]) {
  captures[name] = { dark: await capture(name, "dark"), light: await capture(name, "light") };
}
const heroFile = captureFiles["../assets/captures/hero-dark.png"];
if (!heroFile) throw new Error("No capture hero-dark. Run make site-images.");
const shareImage = await getImage({ src: heroFile.default, width: 1200, format: "jpeg", quality: 80 });
const image = new URL(shareImage.src, Astro.site).href;
const softwareData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Weir",
  description: t.description,
  inLanguage: lang,
  url,
  image,
  applicationCategory: "DeveloperApplication",
  operatingSystem: t.operatingSystem,
  license: "https://opensource.org/license/mit",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
const heroSizes = "min(100vw, 1280px)";
const nonDefaultLang = "ja";
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline define:vars={{ lang, nonDefaultLang, LANG_STORAGE_KEY }}>
      /* Before anything loads, the address the reader wants: `/` opens in the language they last chose, or at first in their browser's. An address that names a language stays there, and `?lang=en` names English where storage cannot hold the choice. */
      if (lang === 'en' && new URLSearchParams(location.search).get('lang') !== 'en') {
        var chosen = null;
        try { chosen = localStorage.getItem(LANG_STORAGE_KEY); } catch (e) {}
        if ((chosen || (navigator.language || 'en').slice(0, 2)) === nonDefaultLang) location.replace('/' + nonDefaultLang + '/' + location.search + location.hash);
      }
    </script>
    <PageHead />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={url} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(homeOf(l.code), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Weir" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={t.title} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={softwareData}></script>
    <script is:inline define:vars={{ hero: captures.hero, heroSizes }}>
      /* The frames are sized by script: nothing glides until they have their first size. */
      document.documentElement.classList.add('is-resizing');
      /* A link to a part of the page must not paint the page's top on the way there, so the page stays hidden until the script has put it in place. A reload is not arriving: the browser returns to where the reader was. */
      var isArriving = location.hash && performance.getEntriesByType('navigation')[0].type !== 'reload';
      if (isArriving) document.documentElement.classList.add('is-arriving');
      /* The hero's address depends on the look, so the browser cannot find it in the markup early enough without this. */
      var heroFile = hero[document.documentElement.dataset.theme];
      var preload = document.createElement('link');
      preload.rel = 'preload'; preload.as = 'image'; preload.fetchPriority = 'high';
      preload.imageSrcset = heroFile.small + ' 1440w, ' + heroFile.large + ' 2880w';
      preload.imageSizes = heroSizes;
      document.head.appendChild(preload);
    </script>
  </head>
  <body>
    <div id="site" data-lang={lang}>
      <SiteNav class="nav-on-page gut" lang={lang} homeHref="#top" productHref="#story" />

      <main id="top">

        <!-- ========== Hero ========== -->
        <div class="gut"><div class="max hero-screen">
          <section class="hero">
            <h1 set:html={t.heroTitle} />
            <p set:html={t.heroBody} />
            <div class="acts">
              <a class="pill" href={DOWNLOAD_URL} target="_blank" rel="noopener">
                {LANGS.map((l) => <span class={l.code === lang ? undefined : "is-reserved"}>{STRINGS[l.code].downloadForMac}</span>)}
              </a>
              <a href={REPO_URL} target="_blank" rel="noopener">
                {LANGS.map((l) => <span class={l.code === lang ? undefined : "is-reserved"}>{STRINGS[l.code].viewOnGitHub}</span>)}
                →
              </a>
            </div>
          </section>
          <noscript><img class="no-script-capture" src={captures.hero?.dark?.small} alt={t.imageAlt} width="1440" height="900" /></noscript>
          <div class="peek">
            <div class="frame" id="f0">
              <div class="stage-w">
                <!-- The script clones this window into the story's frame and gives each capture its address for the current look. -->
                <div class="w" id="win" data-hero-sizes={heroSizes}>
                  <img alt={t.imageAlt} width="1440" height="900" />
                  <div class="spot" hidden></div>
                </div>
              </div>
            </div>
          </div>
        </div></div>

        <!-- ========== Scroll story: one caption for each entry of `steps` in the script, in the same order ========== -->
        <section class="story gut" id="story"><div class="pin max">
          <div class="caps" id="caps">
            {t.captions.map(([title, body], i) => (
              <div class:list={["cap", { on: i === 0 }]}>
                <h2 set:html={title} />
                <p set:html={body} />
              </div>
            ))}
          </div>
          <div class="st">
            <div class="frame" id="f1"><div class="stage-w" id="sw"></div></div>
            <ol class="dots" id="dots" aria-hidden="true"></ol>
          </div>
        </div></section>

        <!-- ========== The page's end ========== -->
        <div class="gut"><div class="max end-screen">
          <section class="quiet">
            <h2 set:html={t.quietTitle} />
            <p set:html={t.quietBody} />
          </section>
          <section>
            {t.specs.map(([label, value]) => (
              <div class="spec">
                <span>{label}</span>
                <span>{value}</span>
              </div>
            ))}
          </section>
          <section class="end">
            <h2 set:html={t.endTitle} />
            <a class="pill" href={DOWNLOAD_URL} target="_blank" rel="noopener">
              {LANGS.map((l) => <span class={l.code === lang ? undefined : "is-reserved"}>{STRINGS[l.code].downloadForMac}</span>)}
            </a>
          </section>
        </div></div>

      </main>

      <!-- ========== Footer ========== -->
      <footer class="foot gut"><div class="max">
        <span>Weir</span>
        <span class="sp"></span>
        <a href="#story">{t.product}</a>
        <a href={docsOf(lang)}>{t.docs}</a>
        <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
      </div></footer>
    </div>
    <script is:inline type="application/json" id="captures" set:html={JSON.stringify(captures)}></script>
    <script is:inline set:html={landingScript}></script>
  </body>
</html>
