#!/bin/sh
# Weir opencode shim: intercepts `opencode` invocations inside a Weir pty.
# OpenCode runs its sessions on a background service that every terminal shares,
# so what tells panes apart is a plugin in the interface itself. OpenCode takes
# none on its command line that keeps the person's own settings readable, so we
# keep the plugin in its folder, where it reports only for a launch through here.
#
# Locate the real opencode: WEIR_REAL_OPENCODE (an explicit override, a test's
# stub, taken outside an app bundle only), then the PATH without our own
# directory, then WEIR_FOUND_OPENCODE (the one the new workspace sheet found),
# then the agent catalog's known locations.

set -u

self="$(command -v -- "$0" 2>/dev/null || printf '%s\n' "$0")"
case "$self" in
  /*) ;;
  *) self="$PWD/$self" ;;
esac
self_dir="$(cd -- "$(dirname -- "$self")" && pwd -P)"
# The overrides the test suites use (the real opencode, the Hook Helper) are
# taken only outside an app bundle, where they run this script from the source
# tree. A bundle carries its own of each, and nothing in the environment
# chooses another.
case "$self_dir" in
  *.app/Contents/Resources/*) unset WEIR_REAL_OPENCODE WEIR_HOOK_HELPER ;;
esac
runtime_common="$self_dir/../agent-shim/runtime-common.sh"
if [ -r "$runtime_common" ]; then
  . "$runtime_common"
  weir_ensure_run_id
fi

# The PATH without our own folder (`weir_filter_path`). Without the shared
# runtime there is none, and the PATH is not searched: it would find us.
filtered_path="${PATH:-}"
has_filtered_path=0
if command -v weir_filter_path >/dev/null 2>&1; then
  weir_filter_path "$self_dir" "$self" opencode
  filtered_path="$weir_filtered_path"
  has_filtered_path=1
fi

found_opencode="${WEIR_FOUND_OPENCODE:-}"
unset WEIR_FOUND_OPENCODE

real_opencode="${WEIR_REAL_OPENCODE:-}"
found_off_path=0
if [ -z "$real_opencode" ] && [ "$has_filtered_path" = 1 ]; then
  real_opencode=$(PATH="$filtered_path" command -v opencode 2>/dev/null || true)
fi
if [ -z "$real_opencode" ] && [ -n "$found_opencode" ] && [ -f "$found_opencode" ] && [ -x "$found_opencode" ] &&
  [ ! "$found_opencode" -ef "$self" ] && [ ! -e "${found_opencode%/*}/weir-hook" ]; then
  real_opencode="$found_opencode"
  found_off_path=1
fi
if [ -z "$real_opencode" ] && command -v weir_find_known_agent >/dev/null 2>&1 &&
  weir_find_known_agent "${WEIR_OPENCODE_KNOWN_LOCATIONS:-}" "$self"; then
  real_opencode="$weir_known_agent"
  found_off_path=1
fi

if [ -z "$real_opencode" ]; then
  printf 'weir: opencode not found in PATH or the usual install folders (searched without %s)\n' "$self_dir" >&2
  exit 127
fi

# Set when opencode is a script for the node beside it, found off the PATH
# (`weir_add_agent_folder`).
opencode_node=""
PATH="$filtered_path"
export PATH
if [ "$found_off_path" = 1 ] && command -v weir_add_agent_folder >/dev/null 2>&1 &&
  weir_add_agent_folder "$real_opencode"; then
  opencode_node="$weir_agent_node"
fi

# Serializes the ownership check, file replacements, and final version mark.
# A missing runtime or a busy lock leaves the agent to start without placement.
weir_place_plugin() {
  source_dir="$self_dir/../opencode-plugin"
  # OPENCODE_CONFIG_DIR replaces the XDG folder: OpenCode then loads no plugin
  # from the other folder, so placing there would leave this launch unwatched.
  if [ -n "${OPENCODE_CONFIG_DIR:-}" ]; then
    target="$OPENCODE_CONFIG_DIR/plugins/weir"
  else
    config_home="${XDG_CONFIG_HOME:-${HOME:-}/.config}"
    [ "$config_home" != "/.config" ] || return 0
    target="$config_home/opencode/plugins/weir"
  fi
  command -v weir_with_placement_lock >/dev/null 2>&1 || return 0
  [ ! -L "${target%/*}" ] || return 0
  weir_with_placement_lock "${target%/plugins/weir}/.weir-placement.lock" weir_place_managed_plugin \
    "$source_dir" "$target" tui.js
}

# Whether these arguments start the terminal interface rather than a subcommand,
# which starts no agent of a pane's. The rule is OpenCode's: a first word that is
# a subcommand runs it, and any other first word is the folder to start in. A
# question about OpenCode itself starts nothing either.
weir_starts_interface() {
  case "${1:-}" in
    upgrade | update | uninstall | acp | api | debug | auth | mcp | plugin | models | stats | mini | run | session | service | reload | pair | serve)
      return 1
      ;;
  esac
  for arg in "$@"; do
    case "$arg" in
      -h | --help | -v | --version | --completions | --completions=* | --wizard) return 1 ;;
    esac
  done
  return 0
}

# Reads what the launch names for the plugin: the session it resumes, whether it
# carries a prompt OpenCode sends by itself (an empty one it does not), which comes
# with no key press to tell whose it is,
# whether it reaches a server somewhere else, whose work is not this folder's, and
# the folder the interface starts in. That folder is OpenCode's one positional
# argument, which may come before or after the options (`opencode --help` at v2.2.5),
# so it is the first word that is no option and no option's value: `--session`, `-s`,
# `--prompt`, `--server`, and `--log-level` take one, and a boolean flag takes a
# `true` or `false` after it.
weir_read_arguments() {
  launch_session=""
  launch_prompt=0
  names_server=0
  launch_directory=""
  previous=""
  is_after_options=0
  for arg in "$@"; do
    is_value=0
    if [ "$is_after_options" = 0 ]; then
      case "$previous" in
        --session | -s) launch_session="$arg" is_value=1 ;;
        --prompt)
          [ -z "$arg" ] || launch_prompt=1
          is_value=1
          ;;
        --server | --log-level) is_value=1 ;;
        --auto | --continue | -c | --standalone | --print-logs)
          case "$arg" in true | false) is_value=1 ;; esac
          ;;
      esac
    fi
    if [ "$is_value" = 0 ] && [ "$is_after_options" = 0 ]; then
      case "$arg" in
        --session=*) launch_session="${arg#--session=}" ;;
        -s=*) launch_session="${arg#-s=}" ;;
        --prompt=?*) launch_prompt=1 ;;
        --server | --server=*) names_server=1 ;;
        --)
          is_after_options=1
          previous=""
          continue
          ;;
        -*) ;;
        *) [ -n "$launch_directory" ] || launch_directory="$arg" ;;
      esac
    elif [ "$is_value" = 0 ]; then
      [ -n "$launch_directory" ] || launch_directory="$arg"
    fi
    previous="$arg"
  done
}

# Keeps this launch's `WEIR_*` for the plugin, in a file only it reads and removes,
# then takes them out of the environment with the shims on the `PATH`. OpenCode hands
# its interface's environment to each session it shows, and that session's commands
# run with it, so a `claude` the agent runs would otherwise report as this pane's. A
# failure leaves `opencode` to start, unwatched.
# The pane's variables, read once the launch's own are exported; the scrub after it
# takes the same list, as nothing in between changes the environment.
weir_pane_names() {
  [ -n "${weir_names+set}" ] || weir_names=$(env | sed -n 's/^\(WEIR_[A-Za-z0-9_]*\)=.*/\1/p')
}

weir_keep_pane_environment() {
  pane_env_dir="$WEIR_OPENCODE_AGENT_STATES_DIR/pane-env"
  mkdir -p "$pane_env_dir" 2>/dev/null || return 0
  find "$pane_env_dir" -type f -mtime +1 -exec rm -f {} + 2>/dev/null
  # Unique to this launch, and 0600 from the start.
  pane_env_file=$(/usr/bin/mktemp "$pane_env_dir/XXXXXXXXXXXX") || return 0
  weir_pane_names
  (
    for name in $weir_names; do
      eval "printf '%s=%s\\0' \"\$name\" \"\${$name:-}\""
    done >"$pane_env_file"
  ) 2>/dev/null || return 0
  kept_pane_env="$pane_env_file"
}

weir_scrub_environment() {
  weir_pane_names
  for name in $weir_names; do
    unset "$name"
  done
  # Our folder for the pane's shell, which would re-add the shims. A person's own
  # stays, as anywhere else.
  case "${ZDOTDIR:-}" in
    */claude-shim/zdotdir | */claude-shim/zdotdir/) unset ZDOTDIR ;;
  esac
  [ -z "$kept_pane_env" ] || export WEIR_OPENCODE_PANE_ENV="$kept_pane_env"
}

# Saves the start of the turn `--prompt` sends, as Enter's gate does for a typed
# input. The interface sends that input by itself as it comes up, with no key for
# the gate to hold and no wait the plugin could put before it, so the start is taken
# here, before OpenCode runs at all. The plugin hands the generation to the turn that
# input starts. The folder is where the interface starts (`weir_read_arguments`).
# Should OpenCode read the arguments otherwise, the runtime compares the worktrees and
# refuses a start saved in another, so that turn has no start, as before. So does a
# start that cannot be saved, or a path JSON cannot carry plainly.
weir_prepare_launch_prompt() {
  [ "$launch_prompt" = 1 ] || return 0
  [ -x "$self_dir/weir-hook" ] || return 0
  prepare_dir="$PWD"
  if [ -n "$launch_directory" ]; then
    [ -d "$launch_directory" ] || return 0
    # The sentinel preserves trailing newlines through command substitution.
    prepare_dir=$(CDPATH='' cd -- "$launch_directory" 2>/dev/null && pwd && printf .) || return 0
    prepare_dir=${prepare_dir%?.}
  fi
  [ -n "$prepare_dir" ] || return 0
  prepare_generation=$(/usr/bin/uuidgen 2>/dev/null | tr 'A-F' 'a-f')
  [ -n "$prepare_generation" ] || return 0
  # The plugin's limits: the hook is told 8 s (`hookTimeLimit` of 10 s), which stops
  # its git, and is killed at 10 s, as a wait for the worktree lock does not heed the
  # first. OpenCode starts no later than that, with no start named. The shell's own
  # notes on the jobs it reaps go nowhere; the hook's errors still reach the pane.
  (
    WEIR_HOOK_TIME_LIMIT_MS=8000 "$self_dir/weir-hook" report weir.prepare \
      --string preparation "$prepare_generation" --string cwd "$prepare_dir" \
      --empty-object data >/dev/null 2>&3 &
    prepare_pid=$!
    (
      sleep 10
      kill -TERM "$prepare_pid"
    ) >/dev/null 2>&1 &
    prepare_watch=$!
    wait "$prepare_pid"
    prepare_status=$?
    kill -TERM "$prepare_watch"
    exit "$prepare_status"
  ) 3>&2 2>/dev/null || return 0
  export WEIR_OPENCODE_LAUNCH_PREPARATION="$prepare_generation"
}

kept_pane_env=""

# `$$` becomes the agent's pid at the exec, which the host's liveness sweep
# watches.
export WEIR_OPENCODE_PID="$$"

# Tells a pane with records apart from a demo's, whose directories are blank: a
# demo run reports nothing and changes nothing of the person's. A launch that
# reaches another server keeps OpenCode's own doing, unwatched: its sessions'
# folders are not this machine's to snapshot.
if [ -n "${WEIR_OPENCODE_AGENT_STATES_DIR:-}" ] && weir_starts_interface "$@"; then
  weir_read_arguments "$@"
  weir_place_plugin
  if [ "$names_server" = 0 ]; then
    export WEIR_OPENCODE_HOOK_DIR="$self_dir"
    export WEIR_OPENCODE_LAUNCH_SESSION="$launch_session"
    export WEIR_OPENCODE_LAUNCH_PROMPT="$launch_prompt"
    weir_prepare_launch_prompt
    weir_keep_pane_environment
  fi
fi
weir_scrub_environment

if [ -n "$opencode_node" ]; then
  exec "$opencode_node" "$real_opencode" "$@"
fi
exec "$real_opencode" "$@"
