#!/bin/sh
# Weir's agy hook: each hook of the plugin runs this with the event's name, and
# `worktree` for the intercept. Weir places the plugin in `agy`'s own folder,
# which every `agy` reads, so outside a Weir pane this does nothing at all.
#
# It always exits 0 with JSON on stdout. `agy` treats any other result as the
# tool failing and its model retries the call (agy 1.4.12, against its
# documentation), so a broken Weir must never reach it.

event="${1:-}"
kind="${2:-}"

reply_default() {
  case "$event" in
    PreToolUse) printf '{"decision":"allow"}\n' ;;
    *) printf '{}\n' ;;
  esac
}

hook="${WEIR_ANTIGRAVITY_HOOK_DIR:-}/weir-hook"
if [ -z "${WEIR_ANTIGRAVITY_HOOK_DIR:-}" ] || [ ! -r "$hook" ]; then
  cat >/dev/null
  reply_default
  exit 0
fi

# Every Weir build on the Mac shares this plugin, but each pane's helper is the
# one its own build bundles, and builds pass the helper different arguments.
# So we hand the call to the dispatch script bundled beside that helper, which
# speaks its language; the bundled copy is this one and goes on below.
bundled_dispatch="$WEIR_ANTIGRAVITY_HOOK_DIR/../antigravity-plugin/scripts/weir-dispatch"
if [ -r "$bundled_dispatch" ] && [ ! "$bundled_dispatch" -ef "$0" ]; then
  exec /bin/sh "$bundled_dispatch" "$@"
fi

# Hooks run in the plugin's folder; the session's is where a turn is recorded.
cd -- "${WEIR_ANTIGRAVITY_WORKSPACE:-.}" 2>/dev/null || :

# We pass the event separately because agy's payload names none, and the
# runtime adds it to the parsed object, so the payload's spelling cannot break it.
reply=$(/bin/sh "$hook" event "$event" "$kind" 2>/dev/null) || reply=""
if [ -n "$reply" ]; then
  printf '%s\n' "$reply"
else
  reply_default
fi
exit 0
